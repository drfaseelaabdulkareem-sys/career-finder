# ============================================================
# Paste these into Netlify → Site configuration →
# Environment variables. Never prefix any of them with VITE_ —
# anything VITE_ gets baked into the public JavaScript file.
# ============================================================

# Your live site, no trailing slash.
APP_URL=https://your-site-name.netlify.app

# Signs buyer sessions. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-with-96-random-hex-characters

# Password for your buyer list at /api/admin. Pick something long.
ADMIN_PASSWORD=choose-a-strong-password

# Razorpay → Account & Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx

# Razorpay → Settings → Webhooks (you invent this string yourself)
RAZORPAY_WEBHOOK_SECRET=your-webhook-secret

# Brevo → SMTP & API → API Keys
BREVO_API_KEY=xkeysib-xxxxxxxx
EMAIL_FROM=Career Finder <your.address@gmail.com>
EMAIL_REPLY_TO=your.address@gmail.com
SELLER_ALERT_EMAIL=your.address@gmail.com

# Access policy
ACCESS_DAYS=30
MAX_DEVICES=2
